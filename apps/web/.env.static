# Static build for GitHub Pages: data lives in the browser, no API server.
VITE_DATA_MODE=local
VITE_BASE_PATH=/eisenhower-matrix/

# Optional: set VITE_CALENDAR_PROXY_URL in the build environment (for example
# the GitHub repository variable CALENDAR_PROXY_URL) to enable URL subscriptions
# on the static site. Leave it unset to only allow .ics uploads.
